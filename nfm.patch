diff --git a/syscore/platform/atari/m68k/os.s b/syscore/platform/atari/m68k/os.s
index 47c165a0..1392e481 100644
--- a/syscore/platform/atari/m68k/os.s
+++ b/syscore/platform/atari/m68k/os.s
@@ -36,7 +36,9 @@ runDelayCalibration:
         lea     MFP_TCDCR,a0        ;a0 -> Timer C/D control reg
         ori.b   #$02,(a0)           ;set pre-scaler = divide-by-10 & start TimerD
 
+	ifnd M68K_FASTCALL
         move.l  4(a7),d0            ;loopcount
