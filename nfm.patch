From 6fbcd250719d4d5e81de563d9e89c38f636dda5f Mon Sep 17 00:00:00 2001
From: Miro Kropacek <miro.kropacek@gmail.com>
Date: Sun, 4 Oct 2026 23:42:17 +1000
Subject: [PATCH] Support building with -mfastcall

---
 CMakeLists.txt                         |  8 ++++++++
 cmake.inc/platform.cmake               | 17 +++++++++++++++++
 deps/natfeats/natfeats.h               | 11 +++++++++--
 nfm/driver/common/m68k/opl_cart.s      |  4 ++++
 nfm/driver/common/m68k/opl_lpt.s       |  4 ++++
 nfm/driver/common/m68k/opl_lpt_spi.s   |  4 ++++
 nfm/driver/common/m68k/opll_cart.s     |  2 ++
 nfm/driver/opl3express/atari/usb_api.h |  7 ++++++-
 nfmplay/src/atari/tia_handler_m68k.s   | 12 ++++++------
 plugins/common/tia_handler_m68k.s      | 12 ++++++------
 plugins/jam/jam.c                      |  8 ++++----
 plugins/jam/jam_null.c                 |  8 ++++----
 plugins/mxp/mxp.c                      | 26 +++++++++++++-------------
 plugins/mxp/mxp.h                      |  2 +-
 plugins/mxp/mxp_null.c                 | 26 +++++++++++++-------------
 syscore/include/sc_platform.h          |  5 +++++
 syscore/platform/atari/m68k/os.s       |  2 ++
 17 files changed, 108 insertions(+), 50 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index d08f2b17..597db3f4 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -40,6 +40,14 @@ elseif(M68K_CPU MATCHES "68060")
     set(nfmLibCpuFolder "m68060")
 endif()
 
+if(M68K_FASTCALL)
+    if(nfmLibCpuFolder STREQUAL "")
+        set(nfmLibCpuFolder "mfastcall")
+    else()
+        set(nfmLibCpuFolder "${nfmLibCpuFolder}/mfastcall")
+    endif()
+endif()
+
 endif()    
 
 set(ProfilingLinkLibs)
diff --git a/cmake.inc/platform.cmake b/cmake.inc/platform.cmake
index 4ae17c02..3d91593d 100644
--- a/cmake.inc/platform.cmake
+++ b/cmake.inc/platform.cmake
@@ -220,6 +220,18 @@ elseif(CMAKE_SYSTEM_NAME MATCHES "AtariTOS") # Atari TOS
     set(CMAKE_C_FLAGS_RELEASE "-D_FORTIFY_SOURCE=3 -O2")
     set(CMAKE_C_FLAGS_FINAL "-DNDEBUG -D_FORTIFY_SOURCE=3 -O2 -s")
 
+    option(M68K_FASTCALL "Pass function arguments in registers (-mfastcall)" OFF)
+
+    if(M68K_FASTCALL)
+        if(${TOS_CRT} STREQUAL "nolibc" OR ${TOS_CRT} STREQUAL "nolibc-nocrt0")
+            message(FATAL_ERROR "M68K_FASTCALL is not supported with TOS_CRT=${TOS_CRT}")
+        endif()
+
+        set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -mfastcall")
+        # tells the assembler sources where the arguments are
+        add_compile_definitions(M68K_FASTCALL=1)
+    endif()
+
     if(DEFINED ASAN_CFLAGS)
         set(CMAKE_STATIC_LINKER_FLAGS ${CMAKE_STATIC_LINKER_FLAGS} ${ASAN_CFLAGS})
     else()
@@ -315,6 +327,11 @@ elseif(CMAKE_SYSTEM_NAME MATCHES "AtariTOS") # Atari TOS
         endif()
     endif()
 
+    if(M68K_FASTCALL AND ${TOS_CRT} STREQUAL "cmini")
+        set(LibCMiniLibDir ${LibCMiniLibDir}/mfastcall)
+        set(LibCMiniStartup ${LibCMiniLibDir}/crt0.o)
+    endif()
+
     if(${TOS_CRT} STREQUAL "stdlib")
         #message("Using standard startup/libc")
         add_compile_definitions(SC_USE_LIBC=1 IO_USE_POSIX=1 IO_USE_GEMDOS=0)
diff --git a/deps/natfeats/natfeats.h b/deps/natfeats/natfeats.h
index e5e6751c..10f3e58c 100644
--- a/deps/natfeats/natfeats.h
+++ b/deps/natfeats/natfeats.h
@@ -11,9 +11,16 @@
 #ifndef _NATFEAT_H
 #define _NATFEAT_H
 
+/* NatFeats opcodes expect their arguments on the stack */
+#ifdef __FASTCALL__
+#define NF_CDECL __attribute__((cdecl))
+#else
+#define NF_CDECL
+#endif
+
 /* nf_asm.s ASM helper interface for natfeats.c */
-long nf_id(const char *);
-long nf_call(long ID, ...);
+long NF_CDECL nf_id(const char *);
+long NF_CDECL nf_call(long ID, ...);
 /* call only from Supervisor mode */
 int detect_nf(void);
 
diff --git a/nfm/driver/common/m68k/opl_cart.s b/nfm/driver/common/m68k/opl_cart.s
index d37cf05c..7f3db986 100644
--- a/nfm/driver/common/m68k/opl_cart.s
+++ b/nfm/driver/common/m68k/opl_cart.s
@@ -40,7 +40,9 @@ _Opl3CartReset:
 
 Opl3CartWrite:
 _Opl3CartWrite:
+	ifnd M68K_FASTCALL
 	move.l  4(sp),a0                        ; d0/a0 should be saved by caller
+	endif
 	movem.l d2-4/a2,-(sp)                   ; save scratch registers
 
 	move.b 	port(a0),d2           			; opl3 register array 0/1
@@ -91,7 +93,9 @@ _Opl2CartReset:
 
 Opl2CartWrite:
 _Opl2CartWrite:
+	ifnd M68K_FASTCALL
 	move.l  4(sp),a0                        ; d0/a0 should be saved by caller
+	endif
 	
 	movem.l d2-3/a2,-(sp)                   ; save scratch registers
 
diff --git a/nfm/driver/common/m68k/opl_lpt.s b/nfm/driver/common/m68k/opl_lpt.s
index 48b68db6..3e90cc77 100644
--- a/nfm/driver/common/m68k/opl_lpt.s
+++ b/nfm/driver/common/m68k/opl_lpt.s
@@ -62,7 +62,9 @@ _OplxLptDeinit:
 Opl2Write:
 _Opl2Write:
 	movem.l d0-7/a0-6,-(sp)
+	ifnd M68K_FASTCALL
 	move.l  64(sp),a0
+	endif
 
 	move.b 	reg(a0),d0           	; opl2 register address
 	move.b 	val(a0),d1 				; opl2 value to write under previously set address
@@ -122,7 +124,9 @@ _Opl2Write:
 Opl3Write:
 _Opl3Write:
 	movem.l d0-7/a0-6,-(sp)
+	ifnd M68K_FASTCALL
 	move.l  64(sp),a0
+	endif
 	
 	move.b 	port(a0),d2           	; opl3 register array 0/1
 	move.b 	reg(a0),d0           	; opl2 register address
