@@ -17,14 +17,14 @@ timerAVec:
     addq.l  #1,gTimerATicks                    ; increase tick counter
     bset    #0,gTimerALock                     ; lock interrupt
     bne.s   .skipTimerA                         ; skip interrupt if already locked
-    movem.l d0-d1/a0-a1,-(sp)                   ; save gcc regs
-    move.w  16(sp),d0                           ; get old sr
+    movem.l d0-d2/a0-a1,-(sp)                   ; save gcc regs (d2: -mfastcall)
+    move.w  20(sp),d0                           ; get old sr
     or.w    #$2000,d0                           ; keep supervisor status
     move.l  gTimerACallback,a0                 ; get timer functions
     move.b  #$df,$fffffa0f.w                    ; clear in-service
     move.w  d0,sr                               ; enable interrupts as they where
     jsr     (a0)                                ; call timer function
-    movem.l (sp)+,d0-d1/a0-a1                   ; restore gcc regs
+    movem.l (sp)+,d0-d2/a0-a1                   ; restore gcc regs
     bclr    #0,gTimerALock                     ; unlock
     rte
 .skipTimerA:
@@ -60,14 +60,14 @@ _timerAVec:
     addq.l  #1,_gTimerATicks                    ; increase tick counter
     bset    #0,_gTimerALock                     ; lock interrupt
     bne.s   .skipTimerA                         ; skip interrupt if already locked
-    movem.l d0-d1/a0-a1,-(sp)                   ; save gcc regs
-    move.w  16(sp),d0                           ; get old sr
+    movem.l d0-d2/a0-a1,-(sp)                   ; save gcc regs (d2: -mfastcall)
+    move.w  20(sp),d0                           ; get old sr
     or.w    #$2000,d0                           ; keep supervisor status
     move.l  _gTimerACallback,a0                 ; get timer functions
     move.b  #$df,$fffffa0f.w                    ; clear in-service
     move.w  d0,sr                               ; enable interrupts as they where
     jsr     (a0)                                ; call timer function
-    movem.l (sp)+,d0-d1/a0-a1                   ; restore gcc regs
+    movem.l (sp)+,d0-d2/a0-a1                   ; restore gcc regs
     bclr    #0,_gTimerALock                     ; unlock
     rte
 .skipTimerA:
